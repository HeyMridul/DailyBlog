# Copy this file to ".env" and fill in your own values for local development.
# Never commit your real .env file to a public repo.

# The password YOU will use to log into the admin portal.
ADMIN_PASSWORD=change-this-password

# A random secret string used to sign login sessions.
# Any long random string works. Example: run `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on locally (unused on Vercel)
PORT=3000

# Postgres connection string (Neon).
# On Vercel: attach a Postgres database to your project via the Marketplace,
# then run `vercel env pull .env.development.local` to copy the real value
# down automatically — you generally won't type this by hand.
DATABASE_URL=
